 [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "type": "DWS", "template_override": 1, "stimuli_ids": []}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}], "id": 0, "stimuli": [{"_data": [], "type": "welcome", "id": 0, "template_override": 1, "contents": [{}]}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn1le06ob07re2img01.jpg", "images": [{"text": "", "image": "engenn1le06ob07re2img01.jpg", "id": 0, "time": "0"}, {"text": "Ladies and Gentlemen,\nMr. Frank Jones retires tonight. <br />\nWho was Frank Jones? <br />\nHe was the director of our school for 30 years. He was also a good teacher.", "image": "engenn1le06ob07re2img01.jpg", "id": 1, "time": "10000"}, {"text": "Was he a good director? <br />\nYes. He was not our first director, but he was our best director.", "image": "engenn1le06ob07re2img01.jpg", "id": 2, "time": "26000"}, {"text": "How was Frank Jones? <br />\nFrank was a strong and hard-working leader. His job was not easy. He was a great manager. We were all on his team. He was always there to listen. He was there to help. He was a positive role model.", "image": "engenn1le06ob07re2img01.jpg", "id": 3, "time": "35000"}, {"text": "We are sad to see him leave.  <br /> All the best Frank. <br />  A toast to Frank Jones. Cheers!", "image": "engenn1le06ob07re2img01.jpg", "id": 4, "time": "57000"}], "audiosrc": "engenn1le06ob07re2aud01"}}], "id": 1, "template_override": 1, "type": "audio", "_data": [{"content": [], "type": "tips"}], "title": ""}]}]}