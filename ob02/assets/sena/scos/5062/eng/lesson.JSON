, {"type": "skill", "content": "Listening"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: <span class=\"bullet\">Listen to the audio.</span> <span class=\"bullet\">Type in the missing words. </span><span class=\"bullet\">Use capital letters where necessary.</span> \n</br>You have 2 attempts to submit your answers. "}]}]}]}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Personal History"}, {"type": "unit_name", "content": "She Was a Magician"}, {"type": "position", "content": 2}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 6}, {"type": "level", "content": "Beginner"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "unusual"}, {"type": "definition", "content": "different from what you know"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: It was an unusual meal."}, {"type": "audio", "content": "engenn1le06ob02aud08"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you hear in conversations about family history."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "neat"}, {"type": "definition", "content": "great; amazing"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: These old pictures are neat!"}, {"type": "audio", "content": "engenn1le06ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "picnic"}, {"type": "definition", "content": "an informal meal outside"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Let's have a lunch picnic in the park today."}, {"type": "audio", "content": "engenn1le06ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "funny"}, {"type": "definition", "content": "amusing; making someone laugh"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: He is a funny person. He makes me laugh."}, {"type": "audio", "content": "engenn1le06ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "circus"}, {"type": "definition", "content": "a big tent where clowns, acrobats, and animals perform"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We go to the circus when it comes to town."}, {"type": "audio", "content": "engenn1le06ob02aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "magician"}, {"type": "definition", "content": "a person who does tricks to entertain"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: He's a magician. He makes things disappear."}, {"type": "audio", "content": "engenn1le06ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "average"}, {"type": "definition", "content": "normal; typical; usual"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: They are just average people, not special."}, {"type": "audio", "content": "engenn1le06ob02aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "Romania"}, {"type": "definition", "content": "a country in south-east Europe"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: My grandparents are from Romania."}, {"type": "audio", "content": "engenn1le06ob02aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "village"}, {"type": "definition", "content": "a very small city"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: There are only 100 people in that village."}, {"type": "audio", "content": "engenn1le06ob02aud09"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "The Past Tense of The Verb To Be"}, {"type": "describer", "content": " You use the Past tense of  the verb <span class=\"strong\">to be</span> to say who people were, like <span class=\"italic\">he was</span> or <span class=\"italic\">she was</span>. <br /> You use a <span class=\"strong\">wh-question</span> to ask who people were, like <span class=\"italic\">Who was .... ?</span>"}, {"type": "table", "content": "{\"rows\":\"2\",\"columns\":\"3\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Subject</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Verb</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Question</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"He, She, It\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"was\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Who was ... ? <br /> Where was ... ? <br />Was ... ?\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"strong\">Mandy</span>: What was his job?</br><span class=\"strong\">Brad</span>: He was a lion tamer."}, {"type": "example", "content": "<span class=\"strong\">Mandy</span>: Where was she from?</br><span class=\"strong\">Brad</span>: She was from Romania."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Talking About Countries and Nationalities"}, {"type": "describer", "content": " You use the Past tense of the verb <span class=\"strong\">to be</span> to talk about where people were from. <br />You use countries like <span class=\"italic\">Germany</span> or <span class=\"italic\">Romania</span>. <br /> You use nationalities like <span class=\"italic\">German</span> or <span class=\"italic\">Romanian</span>. <br /> You make nationalities with the country and an ending like <span class=\"italic\">-ian</span> or <span class=\"italic\">-an</span>."}, {"type": "table", "content": "{\"rows\":\"4\",\"columns\":\"3\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Country</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Ending</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Example</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Canada <br /> Colombia <br />Romania\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">-ian</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"italic\\\">Canadian<br /> Colombian <br />Romanian</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Germany\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">-an</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"German</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"England <br /> Scotland <br /> Ireland\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">-ish</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"italic\\\">English <br /> Scottish <br /> Irish</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"strong\">Mandy</span>: Where was she born?</br><span class=\"strong\">Brad</span>: She was born in Germany. She was German."}, {"type": "example", "content": "<span class=\"strong\">Mandy</span>: Where was he from?</br><span class=\"strong\">Brad</span>: He was from Romania. He was Romanian."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "German"}, {"type": "definition", "content": "from Germany"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: My great-grandfather is German."}, {"type": "audio", "content": "engenn1le06ob02aud10"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Exchange basic personal information."}, {"type": "secondary_1", "content": "Provides simple personal information in written texts and spoken form through simple comprehensible phrases."}, {"type": "secondary_2", "content": " Understands simple information, vocabulary and expressions in short conversations about personal information."}, {"type": "secondary_3", "content": " Understands simple information, vocabulary and expressions in short conversations about personal information."}, {"type": "secondary_4", "content": " Provides simple personal information in written texts and spoken form through simple comprehensible phrases."}, {"type": "secondary_5", "content": " Provides simple personal information in written texts and spoken form through simple comprehensible phrases."}, {"type": "secondary_6", "content": " Provides simple personal information in written texts and spoken form through simple comprehensible phrases."}, {"type": "secondary_7", "content": " Understands simple information, vocabulary and expressions in short conversations about personal information."}, {"type": "secondary_8", "content": " Provides simple personal information in written texts and spoken form through simple comprehensible phrases."}]}, {"type": "background_image", "content": "engenn1le06ob02re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Find pictures of your family. "}, {"type": "text", "content": "Think of them as you draw your family tree. "}, {"type": "text", "content": "Present your family tree to your partner or class. "}, {"type": "text", "content": "Ask your partner questions about their family. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I talk about my family."}, {"type": "text", "content": "I talk about time and place."}, {"type": "text", "content": "I describe people. "}]}]}